# Netlify → Site settings → Environment variables (atau Extensions → Neon / Netlify DB yang mengisi NETLIFY_DATABASE_URL otomatis)
DATABASE_URL=postgresql://user:password@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# PIN admin untuk upload / reset data di server
ADMIN_TOKEN=ganti-dengan-pin-rahasia
# Seed lewat API site yang sudah deploy: npm run seed -- --api=https://<site>.netlify.app --token=$ADMIN_TOKEN
# Dev lokal tanpa DB: STORE=memory (data hilang saat function restart)
# STORE=memory
