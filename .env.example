# Connection string Neon (Dashboard → Connect → pooled). Dipakai oleh:
#  - npm run dev / vite preview (API /api/data jalan otomatis, tersambung ke Neon)
#  - npm run seed
#  - Netlify: isi env yang sama di Site configuration → Environment variables
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
# Dev tanpa DB (data di memori, hilang saat server restart):
# STORE=memory

# Akun Super Admin dari env. Dibaca apa adanya (boleh berisi # atau $) dan disamakan setiap server start:
# ubah env → password ikut berubah, kunci login (5× salah) dibuka. Begitu password diganti / di-reset
# dari aplikasi, env tidak menimpa lagi.
SUPERADMIN_EMAIL=admin@perusahaan.co.id
SUPERADMIN_PASSWORD=admin123!@#
